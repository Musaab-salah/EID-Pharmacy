# Copy to .env for local use (never commit .env)

# Django
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (Render / production). Omit for local SQLite.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_SSL_REQUIRE=true

# Behind reverse proxy (Render)
# USE_X_FORWARDED_PROTO=true
# SECURE_SSL_REDIRECT=false

# CORS — comma-separated origins when frontends are on another domain
# CORS_ALLOWED_ORIGINS=https://your-app.onrender.com

# Frontends (only if building with Vite against remote API)
# VITE_API_URL=https://your-backend.onrender.com/api
