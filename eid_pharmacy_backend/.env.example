# Copy to .env (do not commit .env)
# See docs/SAAS_DEPLOYMENT.md for production on Render + Vercel.

# --- Local development ---
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# SECRET_KEY=change-me-in-production

# SQLite when DATABASE_URL unset (development only)
# DATABASE_URL=postgres://USER:PASS@HOST:5432/DBNAME

# DATABASE_SSL_REQUIRE=true
# DATABASE_CONN_MAX_AGE=600

# --- Production (DEBUG=false) ---
# SECRET_KEY=<long-random>
# DEBUG=false
# ALLOWED_HOSTS=api.yourdomain.com,.onrender.com
# DATABASE_URL=<postgres-url>
# USE_X_FORWARDED_PROTO=true
# SECURE_SSL_REDIRECT=true

# Vercel frontends (comma-separated, https, no trailing slash):
# CORS_ALLOWED_ORIGINS=https://admin-app.vercel.app,https://pos-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://admin-app.vercel.app,https://pos-app.vercel.app

# CORS_ALLOW_CREDENTIALS=false
